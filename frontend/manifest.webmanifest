      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/app/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/img/app/icon-maskable-512.png",
