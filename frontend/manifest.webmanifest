{
  "id": "/",
  "name": "CódigoCamp",
  "short_name": "CódigoCamp",
  "description": "Aprende a programar en español: retos, lecciones, tutor de IA y un espacio de trabajo como VS Code.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/pages/inicio.html?app=1",
  "scope": "/",
  "display": "standalone",
