{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "ColumnSet", "columns": [
      { "type": "Column", "width": "stretch", "items": [{ "type": "TextBlock", "text": "Calendario de racha", "weight": "Bolder", "size": "Small", "color": "Warning" }] },
      { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "${titulo}", "weight": "Bolder", "size": "Small" }] }
    ] },
    { "type": "TextBlock", "text": "L  M  X  J  V  S  D", "fontType": "Monospace", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "Small" },
    { "type": "TextBlock", "text": "${semana_texto}", "size": "Large", "horizontalAlignment": "Center", "spacing": "None" },
    { "type": "FactSet", "spacing": "Medium", "facts": [
      { "title": "Mejor racha", "value": "${racha_maxima} días" },
      { "title": "Salvarrachas", "value": "${salvarrachas}" }
    ] },
    { "type": "TextBlock", "text": "${estado}", "wrap": true, "isSubtle": true, "size": "Small" }
  ],
  "actions": [{ "type": "Action.OpenUrl", "title": "Ver calendario", "url": "${url_calendario}" }]
}
