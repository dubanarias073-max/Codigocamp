{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "Meta de hoy · ${nombre}", "weight": "Bolder", "color": "Good", "size": "Small" },
    { "type": "ColumnSet", "columns": [
      { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "🎯", "size": "ExtraLarge" }] },
      { "type": "Column", "width": "stretch", "verticalContentAlignment": "Center", "items": [
        { "type": "TextBlock", "text": "${xp_hoy} / ${meta_xp} XP", "weight": "Bolder", "size": "Large" },
        { "type": "TextBlock", "text": "${progreso_hoy}% completado", "isSubtle": true, "spacing": "None" }
      ] }
    ] },
    { "type": "TextBlock", "text": "🔥 ${racha} días · 💎 ${diamantes} · ❤️ ${vidas}", "spacing": "Medium" },
    { "type": "TextBlock", "text": "${estado}", "wrap": true, "isSubtle": true, "size": "Small" }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "Practicar", "url": "${url_practicar}" },
    { "type": "Action.OpenUrl", "title": "Cofres", "url": "${url_cofres}" }
  ]
}
