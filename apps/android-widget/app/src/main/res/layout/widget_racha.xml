<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="CódigoCamp"
            android:textColor="#FF8B95B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#FFE5EAFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/racha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFFF9F1C"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rachaTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="días de racha"
                android:textColor="#FF8B95B8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#FFE5EAFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/semana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:text="L  M  X  J  V  S  D"
        android:textColor="#FFE5EAFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="Toca para configurar el widget"
        android:textColor="#FFCAFF4E"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
